# copy to .env — compose reads this
DATABASE_URL=postgresql://recovery:recovery@postgres:5432/recovery
REDIS_URL=redis://redis:6379/0
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_TASK_QUEUE=recovery-q

# Razorpay TEST MODE keys (dashboard -> settings -> API keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# Tier-3 LLM triage. OPTIONAL — without it the system runs as a
# two-stage classifier with identical safety behaviour.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_TRIAGE_ENABLED=true
LLM_API_KEY=

# demo: enables POST /simulate/failure without a signature
DEMO_MODE=true
CHANNEL_MODE=mock            # mock | live
HOLDOUT_PCT=10
